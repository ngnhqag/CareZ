<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.activity.main.MainActivity">

    <!-- Tiêu đề Trang chủ -->
    <TextView
        android:id="@+id/txtView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="25dp"
        android:fontFamily="@font/lansui"
        android:text="@string/trang_chu"
        android:textSize="35sp"
        app:layout_constraintBottom_toTopOf="@+id/frameLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nội dung hiển thị fragment -->
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtView" />

    <!-- Lớp phủ mờ nền (blur) -->
    <View
        android:id="@+id/overlayBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/frameLayout" />

    <!-- Nhóm FAB -->
    <LinearLayout
        android:id="@+id/layoutFabGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:background="@drawable/bg_fab_line"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/fABAdd"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutDoExercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fABDoExercise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tập thể dục"
                app:icon="@drawable/ic_doexercise"
                app:iconPadding="8dp"
                app:iconGravity="start"
                app:iconTint="@android:color/white"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/teal_700"
                android:clickable="true"
                android:focusable="true"
                android:visibility="invisible"
                android:elevation="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAddMeal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fABAddMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thêm bữa ăn"
                app:icon="@drawable/ic_addmeal"
                app:iconPadding="8dp"
                app:iconGravity="start"
                app:iconTint="@android:color/white"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/teal_700"
                android:clickable="true"
                android:focusable="true"
                android:visibility="invisible"
                android:elevation="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDrinkWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fABDrinkWater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uống nước"
                app:icon="@drawable/ic_drinkwater"
                app:iconPadding="8dp"
                app:iconGravity="start"
                app:iconTint="@android:color/white"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/teal_700"
                android:clickable="true"
                android:focusable="true"
                android:visibility="invisible"
                android:elevation="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nút Add -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fABAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="50dp"
        app:srcCompat="@drawable/ic_add"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:tint="@color/white"
        android:backgroundTint="@color/white"
        android:contentDescription="@string/them_hoat_dong" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        android:elevation="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
